{
  "manifest_version": 3,
  "name": "PIW — Prompt Injection Warning",
  "version": "1.0.0",
  "description": "Detects prompt injection in text pasted to AI chatbots. Local processing, zero telemetry.",
  "permissions": ["storage", "tabs"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "https://copilot.microsoft.com/*",
    "https://perplexity.ai/*",
    "https://poe.com/*",
    "https://chat.mistral.ai/*",
    "https://character.ai/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": [
      "https://chatgpt.com/*",
      "https://chat.openai.com/*",
      "https://claude.ai/*",
      "https://gemini.google.com/*",
      "https://copilot.microsoft.com/*",
      "https://perplexity.ai/*",
      "https://poe.com/*",
      "https://chat.mistral.ai/*",
      "https://character.ai/*"
    ],
    "js": ["content.js"],
    "run_at": "document_idle"
  }],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
